<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copy the built native lib next to the managed output so DllImport("interop") resolves it. -->
    <None Include="../native/libinterop.dylib" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('../native/libinterop.dylib')" />
  </ItemGroup>

</Project>
